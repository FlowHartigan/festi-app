HOST=127.0.0.1
PORT=3001
DATABASE_PATH=.data/festi.sqlite
# En production : clé aléatoire stable d’au moins 32 caractères, sauvegardée séparément.
# En développement, une clé est créée dans .data/account.key si cette variable est absente.
ACCOUNT_SECRET=
# Activer uniquement derrière le Nginx local configuré dans deploy/nginx.conf.
TRUST_PROXY=
