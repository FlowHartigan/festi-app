[Unit]
Description=Festi App API
After=network.target

[Service]
Type=simple
User=festi-app
Group=festi-app
WorkingDirectory=/var/www/festi-app/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/festi-app.env
ExecStart=/usr/bin/node dist-server/server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/festi-app
UMask=0027

[Install]
WantedBy=multi-user.target
